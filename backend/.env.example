# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string (see the root README, Step 3).
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/gamebreak?retryWrites=true&w=majority

# Any long random string — used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

PORT=5000

# Comma-separated list of the exact frontend/dashboard URLs allowed to call
# this API. Include both your local dev URLs and your deployed ones.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
